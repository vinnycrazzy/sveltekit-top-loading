{
	"name": "sveltekit-top-loading",
	"version": "0.1.0",
	"license": "MIT",
	"author": {
		"name": "Vinicius R. Vieira",
		"url": "https://github.com/vinnycrazzy"
	},
	"homepage": "https://github.com/vinnycrazzy/sveltekit-top-loading#readme",
	"bugs": {
		"url": "https://github.com/vinnycrazzy/sveltekit-top-loading/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run check && npm run lint && npm run package",
		"test": "npm run test:integration",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"release": "changeset publish",
		"release:dry-run": "npm publish --dry-run"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"@sveltejs/kit": "^2.12.0 || ^3.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.7",
		"@eslint/js": "^9.0.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/eslint": "^8.56.7",
		"@types/node": "^24.0.0",
		"@types/nprogress": "^0.2.3",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^15.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tslib": "^2.4.1",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"dependencies": {
		"nprogress": "^0.2.0"
	},
	"packageManager": "pnpm@12.6.0",
	"keywords": [
		"Svelte",
		"SvelteKit",
		"SvelteKit Top Loader",
		"Nprogress",
		"Top Loading Bar",
		"Progressbar"
	],
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"description": "Navigation progress bar and fullscreen loading screen for SvelteKit and Svelte 5",
	"contributors": [
		{
			"name": "Sriram Thiagarajan",
			"url": "https://github.com/tsriram"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vinnycrazzy/sveltekit-top-loading.git"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"sideEffects": [
		"**/*.css"
	]
}
